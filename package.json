{
  "name": "modugate-desktop",
  "version": "0.5.0",
  "description": "Windows AI gateway with Agnes video relay, image generation, LAN access, and API compatibility",
  "main": "main.js",
  "author": "Laity1m and ModuGate contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/*.test.js\"",
    "test:lan": "node scripts/lan-smoke.js",
    "test:ui": ".\\node_modules\\electron\\dist\\electron.exe scripts\\ui-smoke.js",
    "verify:jimeng-runtime": "node scripts/verify-jimeng-runtime.js",
    "build:dir": "node scripts/verify-jimeng-runtime.js && electron-builder --win --dir --publish=never",
    "build:win": "node scripts/verify-jimeng-runtime.js && electron-builder --win nsis --publish=never",
    "build:portable": "node scripts/verify-jimeng-runtime.js && electron-builder --win portable --publish=never"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.modugate.desktop",
    "productName": "ModuGate",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release-all-in-one"
    },
    "files": [
      "main.js",
      "preload.js",
      "core/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ModuGate-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
